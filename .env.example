# Optional: enables the full Gemini Bull/Bear/Risk/Final synthesis layer.
# Without it, Ask Warren remains usable with deterministic evidence-aware synthesis.
GEMINI_API_KEY=

# Optional model override
GEMINI_MODEL=gemini-3.6-flash

# Optional web discovery / amalgamation. If absent, Warren skips Exa without
# treating it as an evidence failure.
EXA_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Optional macro evidence. If absent, Deep continues without FRED.
FRED_API_KEY=

# Optional SEC automated-access identifier. Warren has a repository URL default,
# but production deployments should provide an identifying application/contact value.
SEC_USER_AGENT=WarrenStockIntelligence/0.3 contact@example.com
